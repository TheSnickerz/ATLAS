@model ATLAS.Models.VulnerabilityIndexViewModel
@{
    ViewData["Title"] = "Vulnerabilities";
    int pageWindow = 5;
    int firstPage  = Math.Max(1, Model.Page - pageWindow);
    int lastPage   = Math.Min(Model.TotalPages, Model.Page + pageWindow);
}

@* ── Page header ─────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Vulnerability Library</h2>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#gbSyncPanel"
                aria-expanded="false"
                aria-controls="gbSyncPanel">
            &#8635; Import from Greenbone
        </button>
        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#syncPanel"
                aria-expanded="false"
                aria-controls="syncPanel">
            &#8635; Sync from NVD
        </button>
        <a asp-action="Create" class="btn btn-danger">+ Add Manually</a>
    </div>
</div>

@* ── Greenbone sync panel ──────────────────────────────────────────────────── *@
<div class="collapse mb-3" id="gbSyncPanel">
    <div class="card border-success shadow-sm">
        <div class="card-header bg-success text-white fw-semibold">
            Import Findings from Greenbone Scan Results
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Pulls all scan findings from <strong>10.40.10.88:9390</strong> and links them to
                CVEs already in your vulnerability library. New hosts are auto-created as assets.
                Findings not matching an existing CVE are added as new vulnerabilities.
            </p>

            <div class="d-flex gap-2 align-items-center">
                <form id="gbSyncForm">
                    @Html.AntiForgeryToken()
                    <button type="button" id="gbSyncBtn" class="btn btn-success"
                            onclick="startGbSync()">
                        &#8635; Start Import
                    </button>
                </form>
            </div>

            <div id="gbProgress" class="mt-4 d-none">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span id="gbPhaseLabel" class="fw-semibold text-success small"></span>
                    <span id="gbElapsed"    class="text-muted small"></span>
                </div>
                <div class="progress mb-2" style="height:18px;">
                    <div id="gbProgressBar"
                         class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         role="progressbar" style="width:100%"></div>
                </div>
                <div class="d-flex justify-content-between">
                    <small id="gbFetchLabel" class="text-muted"></small>
                    <small id="gbSavedLabel" class="text-muted"></small>
                </div>
                <div id="gbSuccessBanner" class="alert alert-success alert-dismissible fade mt-3 d-none" role="alert">
                    <span id="gbSuccessText"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <div id="gbErrorBanner" class="alert alert-danger alert-dismissible fade mt-3 d-none" role="alert">
                    <span id="gbErrorText"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Greenbone delta section ───────────────────────────────────────────────── *@
<div id="gbFindingDeltaSection" class="d-none mb-4">
    <h5 class="text-success">&#8635; New findings since last Greenbone sync</h5>
    <table class="table table-hover table-bordered table-sm">
        <thead class="table-success">
            <tr><th>CVE</th><th>Title</th><th>Severity</th><th>CVSS</th><th>Asset</th><th>Detected</th></tr>
        </thead>
        <tbody id="gbFindingDeltaBody"></tbody>
    </table>
</div>

@* ── NVD Sync panel ───────────────────────────────────────────────────────── *@
<div class="collapse mb-3" id="syncPanel">
    <div class="card border-primary shadow-sm">
        <div class="card-header bg-primary text-white fw-semibold">
            Sync CVEs from NIST National Vulnerability Database
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Pulls <strong>all matching CVE records</strong> from the
                <a href="https://nvd.nist.gov/developers/vulnerabilities" target="_blank" rel="noopener">
                    NVD API 2.0
                </a>
                and upserts them into your library — new CVEs are added, existing ones are refreshed.
                Leave both filters blank to sync the entire NVD database (~250 k CVEs).
                @if (!Model.NvdKeyConfigured)
                {
                    <span>
                        Without an API key requests are rate-limited (~5 per 30 s); a full unfiltered sync will run
                        in the background for several hours. Add a free key in
                        <code>appsettings.json</code> → <code>"NvdApiKey"</code> to sync the full database in ~15 minutes.
                    </span>
                }
            </p>

            <form id="syncForm">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            Keyword <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input type="text" id="syncKeyword" name="keyword" class="form-control"
                               placeholder="e.g. apache, log4j, windows" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Severity filter <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <select id="syncSeverity" name="severity" class="form-select">
                            <option value="">— All severities —</option>
                            <option value="CRITICAL">Critical</option>
                            <option value="HIGH">High</option>
                            <option value="MEDIUM">Medium</option>
                            <option value="LOW">Low</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="button" id="syncBtn" class="btn btn-primary w-100"
                                onclick="startSync()">
                            &#8635; Start Sync
                        </button>
                    </div>

                </div>
            </form>

            @* ── Live progress panel (hidden until sync starts) ────────────── *@
            <div id="syncProgress" class="mt-4 d-none">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span id="syncPhaseLabel" class="fw-semibold text-primary small"></span>
                    <span id="syncElapsed" class="text-muted small"></span>
                </div>

                <div class="progress mb-2" style="height: 18px;">
                    <div id="syncProgressBar"
                         class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: 0%"
                         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <span id="syncProgressPct"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <small id="syncCountLabel" class="text-muted"></small>
                    <small id="syncSavedLabel" class="text-muted"></small>
                </div>

                @* Success / error banners shown after completion *@
                <div id="syncSuccessBanner" class="alert alert-success alert-dismissible fade mt-3 d-none" role="alert">
                    <span id="syncSuccessText"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <div id="syncErrorBanner" class="alert alert-danger alert-dismissible fade mt-3 d-none" role="alert">
                    <span id="syncErrorText"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>

        </div>
    </div>
</div>

@* ── Summary stats bar ────────────────────────────────────────────────────── *@
<div class="row g-2 mb-3">
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-2 px-1">
                <div class="fs-4 fw-bold">@Model.TotalCount.ToString("N0")</div>
                <div class="small text-muted">Total CVEs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <a asp-action="Index" asp-route-severity="Critical" class="text-decoration-none">
            <div class="card text-center h-100 border-danger">
                <div class="card-body py-2 px-1">
                    <div class="fs-4 fw-bold text-danger">@Model.CriticalCount.ToString("N0")</div>
                    <div class="small text-muted">Critical</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-2">
        <a asp-action="Index" asp-route-severity="High" class="text-decoration-none">
            <div class="card text-center h-100 border-warning">
                <div class="card-body py-2 px-1">
                    <div class="fs-4 fw-bold text-warning">@Model.HighCount.ToString("N0")</div>
                    <div class="small text-muted">High</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-2">
        <a asp-action="Index" asp-route-severity="Medium" class="text-decoration-none">
            <div class="card text-center h-100 border-info">
                <div class="card-body py-2 px-1">
                    <div class="fs-4 fw-bold text-info">@Model.MediumCount.ToString("N0")</div>
                    <div class="small text-muted">Medium</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-2">
        <a asp-action="Index" asp-route-severity="Low" class="text-decoration-none">
            <div class="card text-center h-100">
                <div class="card-body py-2 px-1">
                    <div class="fs-4 fw-bold text-secondary">@Model.LowCount.ToString("N0")</div>
                    <div class="small text-muted">Low</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-2 px-1">
                <div class="small text-muted">Last sync</div>
                <div class="small fw-semibold">
                    @(Model.LastSyncDate.HasValue
                        ? Model.LastSyncDate.Value.ToLocalTime().ToString("yyyy-MM-dd")
                        : "—")
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Filter form ──────────────────────────────────────────────────────────── *@
<form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
    <div class="col-md-5">
        <input type="text" name="search" value="@Model.Search"
               class="form-control" placeholder="Search CVE ID or title keyword…" />
    </div>
    <div class="col-md-3">
        <select name="severity" class="form-select">
            <option value=""    selected="@(string.IsNullOrEmpty(Model.SeverityFilter) ? "selected" : null)">Critical + High (default)</option>
            <option value="all" selected="@(Model.SeverityFilter == "all" ? "selected" : null)">— All severities —</option>
            <option value="Critical"      selected="@(Model.SeverityFilter == "Critical"      ? "selected" : null)">Critical</option>
            <option value="High"          selected="@(Model.SeverityFilter == "High"          ? "selected" : null)">High</option>
            <option value="Medium"        selected="@(Model.SeverityFilter == "Medium"        ? "selected" : null)">Medium</option>
            <option value="Low"           selected="@(Model.SeverityFilter == "Low"           ? "selected" : null)">Low</option>
            <option value="Informational" selected="@(Model.SeverityFilter == "Informational" ? "selected" : null)">Informational</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
</form>

@* ── Results table ────────────────────────────────────────────────────────── *@
<table class="table table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>CVE ID</th>
            <th>Title</th>
            <th>Severity</th>
            <th>CVSS</th>
            <th>Affected Software</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model.Items)
        {
            <tr>
                <td>
                    @if (v.CveId != null)
                    {
                        <a href="https://nvd.nist.gov/vuln/detail/@v.CveId"
                           target="_blank" rel="noopener"
                           class="font-monospace small text-decoration-none">@v.CveId</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td><a asp-action="Details" asp-route-id="@v.Id">@v.Title</a></td>
                <td><span class="severity-@v.Severity.ToString().ToLower()">@v.Severity</span></td>
                <td>@(v.CvssScore?.ToString("F1") ?? "—")</td>
                <td><small>@v.AffectedSoftware</small></td>
                <td>
                    <a asp-action="Edit"   asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    No vulnerabilities match your filter.
                    <a asp-action="Index">Reset filters</a> or use <strong>Sync from NVD</strong> to import CVEs.
                </td>
            </tr>
        }
    </tbody>
</table>

@* ── Result count + pagination ───────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <small class="text-muted">
        @if (Model.TotalFilteredCount > 0)
        {
            int from = (Model.Page - 1) * Model.PageSize + 1;
            int to   = Math.Min(Model.Page * Model.PageSize, Model.TotalFilteredCount);
            @:Showing @from.ToString("N0")–@to.ToString("N0") of @Model.TotalFilteredCount.ToString("N0") results
            @:&nbsp;·&nbsp; @Model.TotalCount.ToString("N0") total CVEs in library
        }
        else
        {
            @:@Model.TotalCount.ToString("N0") total CVEs in library
        }
    </small>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Vulnerability pages">
            <ul class="pagination pagination-sm mb-0">
                @if (firstPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-severity="@Model.SeverityFilter"
                           asp-route-page="1">1</a>
                    </li>
                    @if (firstPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @for (int p = firstPage; p <= lastPage; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-severity="@Model.SeverityFilter"
                           asp-route-page="@p">@p</a>
                    </li>
                }
                @if (lastPage < Model.TotalPages)
                {
                    @if (lastPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-severity="@Model.SeverityFilter"
                           asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
<script>
    // ── Greenbone sync ────────────────────────────────────────────────────────
    let gbPollTimer = null;

    async function startGbSync() {
        const btn   = document.getElementById('gbSyncBtn');
        const token = document.querySelector('#gbSyncForm input[name="__RequestVerificationToken"]').value;
        btn.disabled = true;
        btn.textContent = 'Importing…';

        try {
            const r = await fetch('@Url.Action("Sync", "Greenbone")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });
            const d = await r.json();
            if (!d.started) {
                gbShowError(d.message ?? 'Already running.'); btn.disabled = false; btn.innerHTML = '&#8635; Start Import'; return;
            }
        } catch (e) {
            gbShowError(e.message); btn.disabled = false; btn.innerHTML = '&#8635; Start Import'; return;
        }

        document.getElementById('gbProgress').classList.remove('d-none');
        gbPollTimer = setInterval(gbPollStatus, 2000);
        gbPollStatus();
    }

    async function gbPollStatus() {
        try { const s = await (await fetch('@Url.Action("Status", "Greenbone")')).json(); gbUpdateProgress(s); } catch (_) {}
    }

    function gbUpdateProgress(s) {
        const phaseMap = { Connecting: '🔌 Connecting…', Loading: '📋 Loading…', Fetching: '⬇ Fetching…', Saving: '💾 Saving…', Done: '✔ Complete', Failed: '✘ Failed' };
        document.getElementById('gbPhaseLabel').textContent = phaseMap[s.phase] ?? s.phase;
        document.getElementById('gbElapsed').textContent = s.elapsedSeconds > 0 ? gbFmt(s.elapsedSeconds) : '';

        const saved = [];
        if (s.findingsAdded   > 0) saved.push(s.findingsAdded + ' added');
        if (s.findingsUpdated > 0) saved.push(s.findingsUpdated + ' updated');
        if (s.assetsCreated   > 0) saved.push(s.assetsCreated + ' new assets');
        document.getElementById('gbFetchLabel').textContent  = s.resultsFetched > 0 ? s.resultsFetched.toLocaleString() + ' results fetched' : '';
        document.getElementById('gbSavedLabel').textContent  = saved.join(' · ');

        if (s.isDone) {
            clearInterval(gbPollTimer); gbPollTimer = null;
            const btn = document.getElementById('gbSyncBtn'); btn.disabled = false; btn.innerHTML = '&#8635; Start Import';
            document.getElementById('gbProgressBar').classList.remove('progress-bar-animated', 'progress-bar-striped');
            if (s.phase === 'Done') { gbShowSuccess('✔ Import complete — ' + saved.join(', ') + ' in ' + gbFmt(s.elapsedSeconds) + '.'); loadGbFindingDelta(); }
            else { document.getElementById('gbProgressBar').classList.add('bg-danger'); gbShowError('Import failed: ' + (s.error ?? 'Unknown error')); }
        }
    }

    async function loadGbFindingDelta() {
        try {
            const d = await (await fetch('@Url.Action("FindingDelta", "Greenbone")')).json();
            if (!d.items || d.items.length === 0) return;
            const sc = { Critical: 'danger', High: 'warning', Medium: 'info', Low: 'secondary' };
            const tbody = document.getElementById('gbFindingDeltaBody');
            tbody.innerHTML = '';
            d.items.forEach(function (item) {
                const cls = sc[item.severity] || 'secondary';
                const cveLink = item.cveId
                    ? `<a href="https://nvd.nist.gov/vuln/detail/${item.cveId}" target="_blank" class="font-monospace small">${item.cveId}</a>`
                    : '<span class="text-muted">—</span>';
                tbody.innerHTML += `<tr><td>${cveLink}</td><td>${item.title}</td>
                    <td><span class="badge bg-${cls}">${item.severity}</span></td>
                    <td>${item.cvss != null ? item.cvss.toFixed(1) : '—'}</td>
                    <td><a href="/Assets/Details/${item.assetId}">${item.assetName}</a></td>
                    <td><small>${item.detectedAt}</small></td></tr>`;
            });
            document.getElementById('gbFindingDeltaSection').classList.remove('d-none');
        } catch (_) {}
    }

    function gbFmt(sec) { return sec < 60 ? sec + 's' : Math.floor(sec/60) + 'm ' + (sec%60) + 's'; }
    function gbShowSuccess(msg) { const el = document.getElementById('gbSuccessBanner'); document.getElementById('gbSuccessText').textContent = msg; el.classList.remove('d-none'); el.classList.add('show'); }
    function gbShowError(msg)   { document.getElementById('gbProgress').classList.remove('d-none'); const el = document.getElementById('gbErrorBanner'); document.getElementById('gbErrorText').textContent = msg; el.classList.remove('d-none'); el.classList.add('show'); }

    // ── NVD sync ──────────────────────────────────────────────────────────────
    let pollTimer = null;

    async function startSync() {
        const btn      = document.getElementById('syncBtn');
        const keyword  = document.getElementById('syncKeyword').value;
        const severity = document.getElementById('syncSeverity').value;
        const token    = document.querySelector('#syncForm input[name="__RequestVerificationToken"]').value;

        // Reset UI
        hideBanners();
        btn.disabled = true;
        btn.textContent = 'Syncing\u2026';

        const params = new URLSearchParams({ keyword, severity, __RequestVerificationToken: token });

        try {
            const resp = await fetch('@Url.Action("SyncFromNvd", "Vulnerabilities")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            });
            const data = await resp.json();

            if (!data.started) {
                showError(data.message ?? 'A sync is already running.');
                btn.disabled = false;
                btn.innerHTML = '&#8635; Start Sync';
                return;
            }
        } catch (e) {
            showError('Failed to start sync: ' + e.message);
            btn.disabled = false;
            btn.innerHTML = '&#8635; Start Sync';
            return;
        }

        // Show the progress panel and start polling
        document.getElementById('syncProgress').classList.remove('d-none');
        pollTimer = setInterval(pollStatus, 2000);
        pollStatus(); // immediate first check
    }

    async function pollStatus() {
        try {
            const resp = await fetch('@Url.Action("SyncStatus", "Vulnerabilities")');
            const s    = await resp.json();
            updateProgress(s);
        } catch (_) {
            // Network hiccup — keep polling
        }
    }

    function updateProgress(s) {
        // Phase label
        const phaseMap = {
            'Idle':     'Idle',
            'Fetching': '⬇ Fetching CVEs from NVD\u2026',
            'Saving':   '💾 Saving to database\u2026',
            'Done':     '✔ Sync complete',
            'Failed':   '✘ Sync failed'
        };
        document.getElementById('syncPhaseLabel').textContent =
            phaseMap[s.phase] ?? s.phase;

        // Elapsed time
        document.getElementById('syncElapsed').textContent =
            s.elapsedSeconds > 0 ? formatElapsed(s.elapsedSeconds) : '';

        // Progress bar
        const bar = document.getElementById('syncProgressBar');
        const pct = document.getElementById('syncProgressPct');

        if (s.phase === 'Fetching' && s.totalResults > 0) {
            const p = Math.min(100, Math.round((s.totalFetched / s.totalResults) * 100));
            bar.style.width = p + '%';
            bar.setAttribute('aria-valuenow', p);
            pct.textContent = p + '%';
        } else if (s.phase === 'Saving') {
            bar.style.width = '100%';
            bar.setAttribute('aria-valuenow', 100);
            pct.textContent = '100%';
        } else if (s.isDone) {
            bar.classList.remove('progress-bar-animated', 'progress-bar-striped');
            bar.style.width = '100%';
            bar.setAttribute('aria-valuenow', 100);
            pct.textContent = '100%';
        }

        // Fetch counter (left side)
        const countEl = document.getElementById('syncCountLabel');
        if (s.totalResults > 0) {
            countEl.textContent =
                s.totalFetched.toLocaleString() + ' / ' + s.totalResults.toLocaleString() + ' CVEs fetched';
        } else if (s.totalFetched > 0) {
            countEl.textContent = s.totalFetched.toLocaleString() + ' CVEs fetched';
        } else {
            countEl.textContent = '';
        }

        // Saved counter (right side) — updates live after each committed page
        const savedEl = document.getElementById('syncSavedLabel');
        if (s.added > 0 || s.updated > 0) {
            savedEl.textContent =
                s.added.toLocaleString() + ' added · ' + s.updated.toLocaleString() + ' updated';
        } else {
            savedEl.textContent = '';
        }

        // Finished?
        if (s.isDone) {
            clearInterval(pollTimer);
            pollTimer = null;

            const btn = document.getElementById('syncBtn');
            btn.disabled = false;
            btn.innerHTML = '&#8635; Start Sync';

            bar.classList.remove('progress-bar-animated', 'progress-bar-striped');

            if (s.phase === 'Done') {
                bar.classList.remove('bg-danger');
                showSuccess(
                    '✔ Sync complete — ' +
                    s.added.toLocaleString() + ' CVEs added, ' +
                    s.updated.toLocaleString() + ' updated in ' +
                    formatElapsed(s.elapsedSeconds) + '.'
                );
                // Reload so stats bar updates with fresh counts
                setTimeout(() => location.reload(), 2500);
            } else {
                bar.classList.add('bg-danger');
                showError('Sync failed: ' + (s.error ?? 'Unknown error'));
            }
        }
    }

    function formatElapsed(sec) {
        if (sec < 60) return sec + 's';
        const m = Math.floor(sec / 60), s = sec % 60;
        return m + 'm ' + s + 's';
    }

    function showSuccess(msg) {
        const el = document.getElementById('syncSuccessBanner');
        document.getElementById('syncSuccessText').textContent = msg;
        el.classList.remove('d-none');
        el.classList.add('show');
    }

    function showError(msg) {
        document.getElementById('syncProgress').classList.remove('d-none');
        const el = document.getElementById('syncErrorBanner');
        document.getElementById('syncErrorText').textContent = msg;
        el.classList.remove('d-none');
        el.classList.add('show');
    }

    function hideBanners() {
        ['syncSuccessBanner', 'syncErrorBanner'].forEach(id => {
            const el = document.getElementById(id);
            el.classList.add('d-none');
            el.classList.remove('show');
        });
    }
</script>
}
